<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="mentora.Views.AdminCreateAdminWindow"
        Title="Новый администратор"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#E8EBFF">

    <Window.Styles>

        <Style Selector="Button.primary">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#5B4BFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4D3DEB" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.outline">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#39446B" />
            <Setter Property="BorderBrush" Value="#DDE0E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#747C90" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <Style Selector="TextBlock.error">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#B52C2C" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#F3F4FF" />
        </Style>

    </Window.Styles>

    <StackPanel x:Name="ContentPanel" Margin="24" Spacing="16">

        <TextBlock Text="Новый администратор"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#19234D" />

        <Border Classes="card">
            <StackPanel>

                <TextBlock Text="Логин *" Classes="label" Margin="0,0,0,4" />
                <TextBox x:Name="LoginTextBox" MaxLength="50" />
                <TextBlock x:Name="LoginError" Classes="error" IsVisible="False" />

                <TextBlock Text="Пароль *" Classes="label" />
                <TextBox x:Name="PasswordTextBox" PasswordChar="●" />
                <TextBlock x:Name="PasswordError" Classes="error" IsVisible="False" />

                <TextBlock Text="Повторите пароль *" Classes="label" />
                <TextBox x:Name="RepeatTextBox" PasswordChar="●" />
                <TextBlock x:Name="RepeatError" Classes="error" IsVisible="False" />

                <TextBlock Text="Пароль: минимум 8 символов, хотя бы одна буква и одна цифра."
                           FontSize="12"
                           Foreground="#747C90"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <TextBlock x:Name="MessageText" Classes="error" IsVisible="False" />

            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,12,*">
            <Button Content="Отмена" Classes="outline" Click="CancelButton_Click" />
            <Button Grid.Column="2" Content="Создать" Classes="primary" Click="CreateButton_Click" />
        </Grid>

    </StackPanel>

</Window>