<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="mentora.Views.AdminLogView"
             x:CompileBindings="False">

    <StackPanel Spacing="16">

        <Border Classes="card">
            <StackPanel x:Name="FiltersPanel">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Логин пользователя" Classes="label" Margin="0,0,0,4" />
                        <TextBox x:Name="UserSearchBox" MaxLength="50" KeyDown="SearchBox_KeyDown" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Тип действия" Classes="label" Margin="0,0,0,4" />
                        <ComboBox x:Name="ActionFilter" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Результат" Classes="label" Margin="0,0,0,4" />
                        <ComboBox x:Name="ResultFilter" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="С даты" Classes="label" Margin="0,0,0,4" />
                        <DatePicker x:Name="DateFromPicker" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="По дату" Classes="label" Margin="0,0,0,4" />
                        <DatePicker x:Name="DateToPicker" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Bottom">
                        <Button Content="Найти" Classes="primary" Click="SearchButton_Click" />
                        <Button Content="Сбросить" Classes="link" Click="ResetButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,12,0">
                        <TextBlock Text="Сортировка" Classes="label" Margin="0,0,0,4" />
                        <ComboBox x:Name="SortFilter" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" IsVisible="False" />

        <TextBlock x:Name="ResultsText" FontSize="14" Foreground="#747C90" />

        <ItemsControl x:Name="LogList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="card" Padding="18,12" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="1.3*,1.4*,3*,Auto">

                            <StackPanel>
                                <TextBlock Text="{Binding DateText}" FontSize="13" Foreground="#19234D" />
                                <TextBlock Text="{Binding Login}" FontSize="12" Foreground="#747C90" Margin="0,3,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActionType}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#19234D"
                                       TextWrapping="Wrap"
                                       Margin="8,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Description}"
                                       FontSize="13"
                                       Foreground="#39446B"
                                       TextWrapping="Wrap"
                                       Margin="8,0" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding ResultText}"
                                       Foreground="{Binding ResultBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="PaginationPanel" ColumnDefinitions="Auto,*,Auto" IsVisible="False">
            <Button x:Name="PreviousButton" Content="Назад" Classes="link" Click="PreviousButton_Click" />
            <TextBlock x:Name="PageNumberText" Grid.Column="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#747C90" />
            <Button x:Name="NextButton" Grid.Column="2" Content="Далее" Classes="link" Click="NextButton_Click" />
        </Grid>

    </StackPanel>

</UserControl>