<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="mentora.Views.AdminMeetingsView"
             x:CompileBindings="False">

    <StackPanel x:Name="RootPanel" Spacing="16">

        <Border Classes="card">
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Логин коуча" Classes="label" Margin="0,0,0,4" />
                    <TextBox x:Name="CoachSearchBox" MaxLength="50" KeyDown="SearchBox_KeyDown" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Text="Логин студента" Classes="label" Margin="0,0,0,4" />
                    <TextBox x:Name="StudentSearchBox" MaxLength="50" KeyDown="SearchBox_KeyDown" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Показать" Classes="label" Margin="0,0,0,4" />
                    <ComboBox x:Name="ArchiveFilter" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Встречи с" Classes="label" Margin="0,0,0,4" />
                    <DatePicker x:Name="DateFromPicker" HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Встречи по" Classes="label" Margin="0,0,0,4" />
                    <DatePicker x:Name="DateToPicker" HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2"
                            Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="Найти" Classes="primary" Click="SearchButton_Click" />
                    <Button Content="Сбросить" Classes="link" Click="ResetButton_Click" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,12,0">
                    <TextBlock Text="Сортировка" Classes="label" Margin="0,0,0,4" />
                    <ComboBox x:Name="SortFilter" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" IsVisible="False" />

        <Border x:Name="FormBorder" Classes="card" IsVisible="False">
            <StackPanel>

                <TextBlock x:Name="FormTitle" FontSize="19" FontWeight="SemiBold" Foreground="#19234D" />

                <TextBlock Text="Дата *" Classes="label" />
                <DatePicker x:Name="MeetingDatePicker" />
                <TextBlock x:Name="DateError" FontSize="13" Foreground="#B52C2C" IsVisible="False" />

                <TextBlock Text="Время *" Classes="label" />
                <TimePicker x:Name="MeetingTimePicker" ClockIdentifier="24HourClock" />
                <TextBlock x:Name="TimeError" FontSize="13" Foreground="#B52C2C" IsVisible="False" />

                <TextBlock Text="Тема *" Classes="label" />
                <TextBox x:Name="TopicTextBox" MaxLength="200" />
                <TextBlock x:Name="TopicError" FontSize="13" Foreground="#B52C2C" TextWrapping="Wrap" IsVisible="False" />

                <TextBlock Text="Краткий итог *" Classes="label" />
                <TextBox x:Name="SummaryTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxLength="1000" />
                <TextBlock x:Name="SummaryError" FontSize="13" Foreground="#B52C2C" TextWrapping="Wrap" IsVisible="False" />

                <TextBlock Text="Комментарий коуча" Classes="label" />
                <TextBox x:Name="CommentTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxLength="1000" />

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
                    <Button Content="Сохранить" Classes="primary" Click="SaveButton_Click" />
                    <Button Content="Отмена" Classes="link" Click="CancelButton_Click" />
                </StackPanel>

            </StackPanel>
        </Border>

        <TextBlock x:Name="ResultsText" FontSize="14" Foreground="#747C90" />

        <ItemsControl x:Name="MeetingsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="card" Padding="18,14" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">

                            <StackPanel>
                                <TextBlock Text="{Binding HeaderText}" FontSize="12" Foreground="#747C90" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Topic}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#19234D" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Summary}" FontSize="14" Foreground="#19234D"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding CommentText}" IsVisible="{Binding HasComment}"
                                           FontSize="13" Foreground="#747C90" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="В архиве" IsVisible="{Binding IsArchived}"
                                           FontSize="12" Foreground="#B52C2C" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button Content="Изменить" Classes="link" Tag="{Binding}" Click="EditButton_Click" />
                                <Button Content="{Binding ToggleText}" Classes="link" Tag="{Binding}" Click="ToggleButton_Click" />
                            </StackPanel>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="PaginationPanel" ColumnDefinitions="Auto,*,Auto" IsVisible="False">
            <Button x:Name="PreviousButton" Content="Назад" Classes="link" Click="PreviousButton_Click" />
            <TextBlock x:Name="PageNumberText" Grid.Column="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#747C90" />
            <Button x:Name="NextButton" Grid.Column="2" Content="Далее" Classes="link" Click="NextButton_Click" />
        </Grid>

    </StackPanel>

</UserControl>