<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="mentora.Views.AdminView"
             x:CompileBindings="False"
             Background="#E8EBFF">

    <UserControl.Styles>

        <Style Selector="Button.navigation">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#19234D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.navigation.selected">
            <Setter Property="Background" Value="#E8E9FF" />
            <Setter Property="Foreground" Value="#5B4BFF" />
        </Style>

        <Style Selector="Button.navigation:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F1F0FF" />
            <Setter Property="Foreground" Value="#5B4BFF" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#5B4BFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4D3DEB" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#5B4BFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#DDE1FF" />
            <Setter Property="Foreground" Value="#4D3DEB" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#747C90" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#19234D" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#F3F4FF" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#F3F4FF" />
        </Style>

    </UserControl.Styles>

    <Grid ColumnDefinitions="190,*">

        <Border Background="White" Padding="12,30">

            <StackPanel Spacing="10">

                <TextBlock Text="Mentora"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#19234D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30" />

                <Button x:Name="DashboardButton"
                        Content="Главная"
                        Classes="navigation"
                        Click="DashboardButton_Click" />
                <Button x:Name="UsersButton"
                        Content="Пользователи"
                        Classes="navigation"
                        Click="UsersButton_Click" />

                <Button x:Name="AssignmentsButton"
                        Content="Назначения"
                        Classes="navigation"
                        Click="AssignmentsButton_Click" />

                <Button x:Name="DictionariesButton"
                        Content="Справочники"
                        Classes="navigation"
                        Click="DictionariesButton_Click" />

                <Button x:Name="MeetingsButton"
                        Content="Встречи"
                        Classes="navigation"
                        Click="MeetingsButton_Click" />

                <Button x:Name="StatsButton"
                        Content="Статистика"
                        Classes="navigation"
                        Click="StatsButton_Click" />

                <Button x:Name="LogButton"
                        Content="Журнал"
                        Classes="navigation"
                        Click="LogButton_Click" />

                <Button x:Name="SettingsButton"
                        Content="Настройки"
                        Classes="navigation"
                        Click="SettingsButton_Click" />

            </StackPanel>

        </Border>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              Margin="28,20,28,28">

            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,0,0,24">

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Администратор"
                               Foreground="#19234D"
                               FontSize="13" />

                    <TextBlock x:Name="HeaderNameText"
                               Foreground="#747C90"
                               FontSize="13"
                               Margin="0,4,12,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Выйти"
                        Classes="link"
                        Click="LogoutButton_Click" />

            </Grid>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Spacing="18">

                    <TextBlock x:Name="PageTitleText"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#19234D" />

                    <ContentControl x:Name="SectionHost" />

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</UserControl>