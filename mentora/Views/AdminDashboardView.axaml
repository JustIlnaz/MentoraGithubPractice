<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="mentora.Views.AdminDashboardView"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="Border.stat">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Width" Value="210" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#5B4BFF" />
        </Style>
        <Style Selector="TextBlock.statLabel">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#747C90" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#19234D" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="MessageText" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap" IsVisible="False" />
                <Button x:Name="RefreshButton" Grid.Column="1" Content="Обновить" Classes="link" Click="RefreshButton_Click" />
            </Grid>

            <WrapPanel x:Name="StatsPanel" IsVisible="False">
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock x:Name="ActiveStudentsValue" Classes="statValue" />
                        <TextBlock Text="Активных студентов" Classes="statLabel" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock x:Name="FreeStudentsValue" Classes="statValue" />
                        <TextBlock Text="Свободных студентов (коуч ещё не найден)" Classes="statLabel" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock x:Name="ActiveCoachesValue" Classes="statValue" />
                        <TextBlock Text="Активных коучей" Classes="statLabel" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock x:Name="FreeCoachesValue" Classes="statValue" />
                        <TextBlock Text="Коучей без студента" Classes="statLabel" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock x:Name="ActiveAssignmentsValue" Classes="statValue" />
                        <TextBlock Text="Активных назначений" Classes="statLabel" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock x:Name="CompletedAssignmentsValue" Classes="statValue" />
                        <TextBlock Text="Завершенных назначений" Classes="statLabel" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <StackPanel x:Name="ProgressPanel" Spacing="14" IsVisible="False">
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Выполнение целей по программе" Classes="panelTitle" />
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock x:Name="OverallPercentValue" Classes="statValue" Margin="0,0,24,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <ProgressBar x:Name="OverallBar" Minimum="0" Maximum="100" Height="12" />
                                <TextBlock x:Name="OverallText" FontSize="13" Foreground="#747C90" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,14,*">
                    <Border Classes="panel" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Прогресс по активным парам" Classes="panelTitle" />
                            <TextBlock x:Name="PairsEmpty" Text="Активных назначений нет." FontSize="13" Foreground="#747C90" IsVisible="False" />
                            <ItemsControl x:Name="PairsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="4" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#19234D" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="13" FontWeight="SemiBold" Foreground="#5B4BFF" />
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="8" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="panel" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Выполнено шагов по месяцам" Classes="panelTitle" />
                            <ItemsControl x:Name="MonthsChart">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="64" Height="200" RowDefinitions="*,Auto" Margin="0,0,6,0">
                                            <StackPanel VerticalAlignment="Bottom" Spacing="4">
                                                <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" Foreground="#19234D" HorizontalAlignment="Center" />
                                                <Border Height="{Binding BarHeight}" Width="34" Background="#5B4BFF" CornerRadius="4,4,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="12" Foreground="#747C90" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>